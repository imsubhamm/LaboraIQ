ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://laboraiq:laboraiq@postgres:5432/laboraiq
DEV_AUTH_ENABLED=true
DEV_AUTH_USER_EMAIL=admin@dev.labora.local
DEV_AUTH_ORGANIZATION_CODE=DEVLAB
SESSION_TTL_MINUTES=60
SESSION_SECRET=dev-insecure-session-secret-change-me
CORS_ORIGINS=http://localhost:3000
ANALYZER_OVERLAY_TARGETS=100.122.201.68
LOG_LEVEL=INFO
# Browser can use a relative path behind the same-origin proxy; server routes need an absolute URL.
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://127.0.0.1:8000/api/v1
# Browser may send X-Dev-User-Email only when explicitly enabled (local UI debugging).
NEXT_PUBLIC_DEV_AUTH_HEADER=true
NEXT_PUBLIC_DEV_AUTH_EMAIL=admin@dev.labora.local

# Web gate / admin password login (UAT). Prefer OIDC in production.
# Must match a provisioned active user email (seed uses admin@dev.labora.local).
ADMIN_LOGIN_EMAIL=admin@dev.labora.local
ADMIN_PASSWORD_SHA256=
DEV_AUTH_BYPASS=false

# OIDC (required for production). Set ENVIRONMENT=production, DEV_AUTH_ENABLED=false,
# and a strong SESSION_SECRET. Audience is typically the API identifier / client id.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_JWKS_URL=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
